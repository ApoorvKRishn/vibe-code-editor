# Copy to .env and fill in. On Vercel, add the same keys under
# Project → Settings → Environment Variables.

DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/<db>"

AUTH_SECRET="" # generate with: npx auth secret

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI (any OpenAI-compatible API) ---------------------------------------
# Production: Groq free tier — create a key at https://console.groq.com/keys
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY=""
AI_MODEL="openai/gpt-oss-120b"            # chat assistant
AI_COMPLETION_MODEL="openai/gpt-oss-20b"  # inline completions (faster)
AI_REASONING_EFFORT="low"

# Local development alternative: leave the AI_* keys unset and run Ollama.
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="codellama:latest"
